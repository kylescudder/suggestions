{
  "name": "flex-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite --open",
    "dev:backend": "bun run migrate && bun --watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "migrate": "bun server/migrate.ts",
    "lint": "tsc -p server --pretty false && tsc -p tsconfig.app.json --pretty false && tsc -p tsconfig.node.json --pretty false && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/backend": "3.25.0",
    "@clerk/react": "6.17.8",
    "clsx": "2.1.1",
    "hono": "4.13.13",
    "lucide-react": "0.577.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/bun": "1.4.3",
    "@types/node": "25.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.2",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "npm-run-all2": "8.0.4",
    "postcss": "~8",
    "prettier": "3.7.4",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.0",
    "typescript-eslint": "8.49.0",
    "vite": "7.2.7"
  }
}
