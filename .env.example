DATABASE_URL=postgres://postgres:postgres@localhost:5432/suggestions
PORT=3001

# Default preserves Clerk until the Better Auth release is ready.
# Recreate the app container after changing the runtime provider.
AUTH_PROVIDER=clerk

# Required only with AUTH_PROVIDER=better-auth; keep server-side.
# BETTER_AUTH_URL=https://suggestions.kylescudder.co.uk
# BETTER_AUTH_SECRET=<stable random secret of at least 32 characters>
# BREVO_API_KEY=<Suggestions transactional API key>
# AUTH_EMAIL_FROM=suggestions@kylescudder.co.uk
# AUTH_EMAIL_DAILY_LIMIT=40

# Clerk rollback (https://dashboard.clerk.com → API keys)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Optional: comma-separated origins allowed to call the API, e.g. https://ideas.example.com
CLERK_AUTHORIZED_PARTIES=

# Comma-separated emails that can access the admin dashboard
ADMIN_EMAILS=you@example.com
